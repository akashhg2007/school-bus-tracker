generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum TripType {
  MORNING
  EVENING
}

enum TripStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceType {
  BOARDING
  DROPOFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionPlan {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ==================== CORE MODELS ====================

model School {
  id            String         @id @default(uuid())
  name          String
  address       String
  city          String
  state         String
  phone         String
  email         String
  logo          String?
  isActive      Boolean        @default(true)

  buses         Bus[]
  parents       Parent[]
  drivers       Driver[]
  admins        Admin[]
  routes        Route[]
  announcements Announcement[]
  subscription  Subscription?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ==================== USER MODELS ====================

model Admin {
  id            String         @id @default(uuid())
  name          String
  phone         String         @unique
  email         String?
  password      String?
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isActive      Boolean        @default(true)
  notifications Notification[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
}

model Driver {
  id            String         @id @default(uuid())
  name          String
  phone         String         @unique
  licenseNumber String         @unique
  email         String?
  password      String?
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bus           Bus?
  trips         Trip[]
  fcmToken      String?
  isActive      Boolean        @default(true)
  notifications Notification[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
}

model Parent {
  id            String         @id @default(uuid())
  name          String
  phone         String         @unique
  email         String?
  password      String?
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students      Student[]
  leaveRequests LeaveRequest[]
  fcmToken      String?
  isActive      Boolean        @default(true)
  notifications Notification[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
}

// ==================== BUS & ROUTE MODELS ====================

model Bus {
  id            String         @id @default(uuid())
  busNumber     String
  plateNumber   String
  capacity      Int
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  driverId      String?        @unique
  driver        Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeId       String?
  route         Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  students      Student[]
  trips         Trip[]
  gpsDeviceId   String?        @unique
  maintenance   MaintenanceRecord[]
  isActive      Boolean        @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
  @@index([driverId])
  @@index([routeId])
  @@unique([busNumber, schoolId])
  @@unique([plateNumber, schoolId])
}

model Route {
  id            String         @id @default(uuid())
  name          String
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stops         Stop[]
  buses         Bus[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
}

model Stop {
  id            String         @id @default(uuid())
  name          String
  latitude      Float
  longitude     Float
  routeId       String
  route         Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order         Int
  students      Student[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([routeId])
  @@unique([routeId, order])
}

// ==================== STUDENT MODEL ====================

model Student {
  id            String         @id @default(uuid())
  name          String
  rollNumber    String
  parentId      String
  parent        Parent         @relation(fields: [parentId], references: [id], onDelete: Restrict)
  busId         String?
  bus           Bus?           @relation(fields: [busId], references: [id], onDelete: SetNull)
  stopId        String?
  stop          Stop?          @relation(fields: [stopId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  leaveRequests LeaveRequest[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([parentId])
  @@index([busId])
  @@index([stopId])
  @@index([busId, stopId])
  @@unique([rollNumber, parentId])
}

// ==================== TRIP MODELS ====================

model Trip {
  id            String         @id @default(uuid())
  busId         String
  bus           Bus            @relation(fields: [busId], references: [id], onDelete: Restrict)
  driverId      String
  driver        Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  type          TripType
  status        TripStatus     @default(PENDING)
  startTime     DateTime?
  endTime       DateTime?
  attendance    Attendance[]
  gpsLocations  GpsLocation[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([busId, status, createdAt])
  @@index([driverId, status, createdAt])
  @@index([status])
}

// ==================== GPS & ATTENDANCE MODELS ====================

model GpsLocation {
  id            String         @id @default(uuid())
  tripId        String
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude      Float
  longitude     Float
  speed         Float?
  heading       Float?
  accuracy      Float?

  createdAt     DateTime       @default(now())

  @@index([tripId, createdAt(sort: Desc)])
}

model Attendance {
  id            String         @id @default(uuid())
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tripId        String
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type          AttendanceType
  status        AttendanceStatus
  markedBy      String

  createdAt     DateTime       @default(now())

  @@index([studentId, createdAt])
  @@index([tripId])
  @@index([tripId, type])
  @@unique([studentId, tripId, type])
}

// ==================== NOTIFICATION MODEL ====================

model Notification {
  id            String         @id @default(uuid())
  parentId      String?
  parent        Parent?        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  driverId      String?
  driver        Driver?        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  adminId       String?
  admin         Admin?         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title         String
  body          String
  data          String?
  isRead        Boolean        @default(false)

  createdAt     DateTime       @default(now())

  @@index([parentId, isRead, createdAt])
  @@index([driverId, isRead, createdAt])
  @@index([adminId, isRead, createdAt])
}

// ==================== LEAVE REQUEST MODEL ====================

model LeaveRequest {
  id            String         @id @default(uuid())
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId      String
  parent        Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  date          DateTime
  reason        String
  status        LeaveStatus    @default(PENDING)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([parentId, status])
  @@index([studentId])
  @@index([studentId, status])
}

// ==================== SUBSCRIPTION MODEL ====================

model Subscription {
  id            String         @id @default(uuid())
  schoolId      String         @unique
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan
  studentCount  Int
  startDate     DateTime
  endDate       DateTime
  amount        Float
  status        SubscriptionStatus @default(ACTIVE)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ==================== ANNOUNCEMENT MODEL ====================

model Announcement {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ==================== MAINTENANCE MODEL ====================

model MaintenanceRecord {
  id          String    @id @default(uuid())
  busId       String
  bus         Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  status      MaintenanceStatus @default(PENDING)
  completedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([busId, status, dueDate])
  @@index([status])
}
